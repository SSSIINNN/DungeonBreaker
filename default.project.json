{
  "name": "DungeonBreaker",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMode": "Classic",
        "CameraMinZoomDistance": 6,
        "CameraMaxZoomDistance": 18
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "RedBlock": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [1, 0, 0],
          "Position": [-6, 2, -10],
          "Size": [4, 4, 4]
        }
      },
      "BlueBlock": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0, 0, 1],
          "Position": [6, 2, -10],
          "Size": [4, 4, 4]
        }
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
